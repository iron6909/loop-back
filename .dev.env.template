# 编译期环境变量模板
#
# 用法：复制本文件，填入真实值
#   cp .dev.env.template .dev.env    # 本地调试（flutter run / run_simulator.sh）
#   cp .dev.env.template .prod.env   # 发布（release_*.sh），将 API_BASE_URL 设为全球生产 API
#
# 编译时通过 --dart-define-from-file=.dev.env|.prod.env 注入。
# .dev.env / .prod.env 已被 .gitignore，不会提交，请勿把真实密钥写进本模板。

# 全球 API 地址覆盖；开发默认使用 dev 地址，发布配置请改为全球生产地址。
API_BASE_URL=https://dev.echo-loop.top

# 中国 API 地址；release 包按运行时地区选择此地址，默认值为该生产域名。
API_CHINA_BASE_URL=https://dev.echo-loop.cn
