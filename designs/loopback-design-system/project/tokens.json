{
  "name": "LoopBack",
  "version": 1,
  "color": {
    "themes": [
      { "id": "light", "name": "Light" },
      { "id": "dark", "name": "Dark" }
    ],
    "tokens": [
      { "name": "brand", "value": { "light": "#1976d2", "dark": "#3aa0ff" }, "usage": "Seed / primary: CTA, selected states, radio and check icons." },
      { "name": "brand-active", "value": { "light": "#3aa0ff", "dark": "#3aa0ff" }, "usage": "Navigation bar and rail selected state; the brighter primary for dark surfaces." },
      { "name": "brand-deep", "value": { "light": "#1565c0", "dark": "#1565c0" }, "usage": "Local collection badge; deep end of the app-icon gradient." },
      { "name": "page", "value": { "light": "#f5f6fa", "dark": "#000000" }, "usage": "Page background: light grey, or pure black (AMOLED) in dark." },
      { "name": "card", "value": { "light": "#ffffff", "dark": "#0b0b0b" }, "usage": "Cards, app bar and bottom bar, floating one step above page." },
      { "name": "card-high", "value": { "light": "#ffffff", "dark": "#1c1c1c" }, "usage": "Higher elevated surface (surfaceContainerHighest)." },
      { "name": "sheet", "value": { "light": "#ffffff", "dark": "#1e1e20" }, "usage": "Modal sheets and popup menus; in dark it must stay above the pure-black page." },
      { "name": "ink", "value": { "light": "#1a1c1e", "dark": "#e2e2e9" }, "usage": "Primary text on page and card. Material 3 default onSurface neutrals." },
      { "name": "ink-muted", "value": { "light": "#44474e", "dark": "#c4c6d0" }, "usage": "Secondary text and metadata (M3 onSurfaceVariant)." },
      { "name": "success", "value": { "light": "#2e9e5b", "dark": "#2e9e5b" }, "usage": "Completion and success; shared-collection badge." },
      { "name": "success-container", "value": { "light": "#e3f4e9", "dark": "#e3f4e9" }, "usage": "Pale green container behind success hero bands." },
      { "name": "bookmark", "value": { "light": "#ffc107", "dark": "#ffc107" }, "usage": "Bookmarks, favorites, stars (amber)." },
      { "name": "pin", "value": { "light": "#e53935", "dark": "#e53935" }, "usage": "Pinned-item indicator; red is reserved for error-level states." },
      { "name": "saved-mark", "value": { "light": "#ffa726", "dark": "#ffb74d" }, "usage": "Dotted underline on saved words and phrases (orange = saved)." },
      { "name": "video", "value": { "light": "#7655a6", "dark": "#b39ddb" }, "usage": "Video media type and the study-page recommendation accent (purple)." },
      { "name": "voice-female", "value": { "light": "#e0709f", "dark": "#e0709f" }, "usage": "Female voice label (pink/rose)." },
      { "name": "voice-male", "value": { "light": "#4f8fe0", "dark": "#4f8fe0" }, "usage": "Male voice label; distinct from the brand selected blue." },
      { "name": "podcast", "value": { "light": "#6a1b9a", "dark": "#6a1b9a" }, "usage": "Podcast collection badge (deep purple)." },
      { "name": "gold", "value": { "light": "#c8941a", "dark": "#e8b84b" }, "usage": "Premium accent, only for the crown icon and the recommendation badge." }
    ]
  },
  "type": {
    "fonts": [],
    "families": {
      "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
    },
    "groups": [
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          { "name": "title", "fontSize": "17px", "lineHeight": "24px", "fontWeight": 700, "usage": "App bar titles." },
          { "name": "button", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600, "usage": "Button labels." },
          { "name": "body", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "usage": "Body text." },
          { "name": "label", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400, "usage": "Labels and badges; navigation labels use weight 600." },
          { "name": "caption", "fontSize": "11px", "lineHeight": "16px", "fontWeight": 400, "usage": "Timestamps and secondary notes." }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      { "name": "space-1", "value": "4px", "usage": "Tight gaps (AppSpacing.xs)." },
      { "name": "space-2", "value": "8px", "usage": "Small gaps (AppSpacing.s)." },
      { "name": "space-3", "value": "16px", "usage": "Default gaps and page padding (AppSpacing.m)." },
      { "name": "space-4", "value": "24px", "usage": "Section gaps (AppSpacing.l)." },
      { "name": "space-5", "value": "32px", "usage": "Large section gaps (AppSpacing.xl)." }
    ]
  },
  "radius": {
    "tokens": [
      { "name": "radius-sm", "value": "12px", "usage": "Inputs, list tiles, snackbars." },
      { "name": "radius-md", "value": "16px", "usage": "Cards and all button shapes." },
      { "name": "radius-lg", "value": "18px", "usage": "Popup menus." },
      { "name": "radius-xl", "value": "20px", "usage": "Dialogs." }
    ]
  }
}
